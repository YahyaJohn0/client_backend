NODE_ENV=development
PORT=8080
LOG_LEVEL=info
# Set to 1 when the app runs behind a hosting platform's reverse proxy.
TRUST_PROXY=1
# The bundled storefront server (:3000) and the Vite dev server (:5173).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
FIREBASE_PROJECT_ID=your-firebase-project-id
# Configure either FIREBASE_SERVICE_ACCOUNT_JSON or GOOGLE_APPLICATION_CREDENTIALS in your local environment.
ADMIN_UIDS=
ORDER_TRACKING_HMAC_SECRET=replace-with-a-random-secret-of-at-least-32-characters
COD_ENABLED=true
DEFAULT_SHIPPING_FEE=0
